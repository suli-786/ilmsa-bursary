---
/**
 * Footer.astro — slim NPO registration strip, shared by every page.
 * (Previously only on /give; the larger footer was dropped with the
 * 2026-11-17 home-page brief.)
 *
 * `class` overrides the top margin (default mt-6), e.g. "mt-0" when the
 * section above already ends in a full-width band.
 */
interface Props {
  class?: string;
}
const { class: spacing = "mt-6" } = Astro.props;
---
<footer class={`${spacing} border-t border-slate-200 bg-[#F7F7F7] py-4 text-center text-xs text-slate-600`}>
  065-012-NPO
</footer>
