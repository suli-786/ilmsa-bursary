---
/**
 * SpeakerCard — one component looped over speakers[] (design/03 §4, design/02
 * "Speaker card"). `variant` selects the portrait frame: "niche" = the arch echo
 * (headliners Ebrahim & Rosieda, larger) · "circle" = the circular grid card.
 * Everything else is identical (name h3 · topic · bio disclosure) — the structural
 * guarantee of the client's "equal sizes / spacing / alignment".
 *
 * Portraits are the A2/A2b square tiles (subject baked on the D26 gradient); the
 * circle/arch mask + 4px off-white ring + 1px keyline are applied here in CSS
 * (tokens). Images resolved via import.meta.glob → astro:assets <Image>; the square
 * source is shown with object-fit:cover so no distortion.
 *
 * Bio = an accessible disclosure: the full bio is always in the DOM (clamped to 3
 * lines) so screen readers get it intact; the <button aria-expanded> just toggles the
 * visual clamp. Motion: card reveals (.daybreak-reveal) + portrait settles
 * (.daybreak-settle); both lit & static under reduced-motion.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Speaker } from "../../data/muslimah-today/speakers.ts";
import Arch from "./Arch.astro";

interface Props {
  speaker: Speaker;
  /** Stagger index (for the reveal fallback delay). */
  index?: number;
}
const { speaker, index = 0 } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/muslimah-today/speakers/*.{jpg,jpeg,png}",
  { eager: true },
);
const img = images[`../../assets/muslimah-today/speakers/${speaker.image}`]?.default;

const isNiche = speaker.variant === "niche";
const renderPx = isNiche ? 600 : 400; // square render size from the 900² source
const slug = speaker.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const bioId = `mt-bio-${slug}`;
---
<article class={`mt-speaker mt-speaker--${speaker.variant} daybreak-reveal`} style={`--daybreak-i: ${index}`}>
  {isNiche ? (
    <div class="mt-speaker__niche daybreak-settle">
      <Arch ring>
        {img && <Image src={img} alt={speaker.name} width={renderPx} height={renderPx} loading="lazy" />}
      </Arch>
    </div>
  ) : (
    <div class="mt-speaker__circle daybreak-settle">
      {img && <Image src={img} alt={speaker.name} width={renderPx} height={renderPx} loading="lazy" />}
    </div>
  )}

  <h3 class="mt-speaker__name">{speaker.name}</h3>
  <p class="mt-speaker__topic">{speaker.topic}</p>

  <div class="mt-speaker__bio">
    <p class="mt-speaker__bio-text" id={bioId}>{speaker.bio}</p>
    <button type="button" class="mt-speaker__bio-toggle" aria-expanded="false" aria-controls={bioId}>
      <span class="mt-speaker__bio-toggle-text">Read bio</span>
      <span class="mt-speaker__bio-toggle-icon" aria-hidden="true">▸</span>
    </button>
  </div>
</article>

<style>
  .mt-speaker {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  /* Circular grid portrait — Ø144 mobile / 160 desktop, 4px ring + 1px keyline. */
  .mt-speaker__circle {
    width: 9rem;
    height: 9rem;
    border-radius: var(--radius-circle);
    overflow: hidden;
    box-shadow: 0 0 0 4px var(--mt-ring), 0 0 0 5px var(--mt-border);
  }
  .mt-speaker__circle img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Headliner arch niche — larger, the one arch echo. Ring via Arch's `ring` prop. */
  .mt-speaker__niche {
    width: clamp(11rem, 62vw, 15rem);
    margin-inline: auto;
  }
  .mt-speaker__niche :global(.mt-arch) {
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .mt-speaker__niche img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mt-speaker__name {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    color: var(--mt-heading);
  }
  .mt-speaker__topic {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--lh-snug);
    color: var(--mt-text);
    text-wrap: balance;
  }

  .mt-speaker__bio {
    width: 100%;
    max-width: 34rem;
  }
  .mt-speaker__bio-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--mt-text-muted);
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mt-speaker__bio.is-expanded .mt-speaker__bio-text {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }
  .mt-speaker__bio-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-1);
    padding: var(--space-1) var(--space-2);
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--mt-link);
  }
  .mt-speaker__bio-toggle:hover,
  .mt-speaker__bio-toggle:focus-visible {
    color: var(--mt-link-hover);
  }
  .mt-speaker__bio-toggle-icon {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .mt-speaker__bio.is-expanded .mt-speaker__bio-toggle-icon {
    transform: rotate(90deg);
  }

  @media (min-width: 1024px) {
    .mt-speaker--circle .mt-speaker__circle {
      width: 10rem;
      height: 10rem;
    }
  }
</style>

<script>
  // Bio disclosure — toggle the visual clamp + aria-expanded + label. The full bio is
  // always in the DOM (clamped via CSS), so screen readers read it intact regardless.
  // One module script handles every card on the page.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".mt-speaker__bio-toggle")) {
    btn.addEventListener("click", () => {
      const bio = btn.closest(".mt-speaker__bio");
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      bio?.classList.toggle("is-expanded", !expanded);
      const label = btn.querySelector(".mt-speaker__bio-toggle-text");
      if (label) label.textContent = expanded ? "Read bio" : "Hide bio";
    });
  }
</script>
