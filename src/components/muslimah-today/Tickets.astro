---
/**
 * Tickets — section #tickets (design/03 §7, design/02 "Ticket tier card"). The
 * scannable centrepiece + warm climax: price + deadline graspable at a glance
 * ("people can't read"), and the page's ONE closing magenta moment (the footer must
 * NOT repeat a full-magenta CTA).
 *
 * Built from ticketTiers[] (← 01-content.md §2) via the variant-driven TicketTier:
 * the featured early-bird card (R250 the single biggest number) + the row list
 * (R320 · R220 WhatsApp · Sponsored apply). Beneath: the sales-close tag (Wed 26th
 * August, verbatim) → the primary Book CTA (M5-disabled) → the verbatim early-bird
 * caption (full wording, for faithfulness). Both deadlines (31 July early-bird, 26
 * August sales-close) are visible without interaction. Motion: reveal + featured
 * bloom; lit & static under reduced-motion.
 */
import { ticketTiers, earlyBirdVerbatim } from "../../data/muslimah-today/ticket-tiers.ts";
import { event } from "../../data/muslimah-today/event.ts";
import SectionHeader from "./SectionHeader.astro";
import TicketTier from "./TicketTier.astro";
import BookButton from "./BookButton.astro";

const featured = ticketTiers.find((t) => t.variant === "featured");
const rows = ticketTiers.filter((t) => t.variant === "row");
---
<section id="tickets" class="mt-tickets" aria-labelledby="mt-tickets-title">
  <div class="mt-tickets__inner">
    <SectionHeader eyebrow="Tickets" heading="Reserve your place" headingId="mt-tickets-title" align="center" />

    <div class="mt-tickets__cols daybreak-reveal">
      <div class="mt-tickets__featured">
        {featured && <TicketTier tier={featured} />}
      </div>
      <ul class="mt-tickets__rows">
        {rows.map((t) => <TicketTier tier={t} />)}
      </ul>
    </div>

    <p class="mt-tickets__tag daybreak-reveal">
      <svg class="mt-tickets__flag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 21V4" />
        <path d="M4 4h13l-2.5 4L17 12H4" />
      </svg>
      <span>Sales close {event.salesClose}</span>
    </p>

    <div class="mt-tickets__cta daybreak-reveal">
      <BookButton block />
    </div>

    <p class="mt-tickets__caption daybreak-reveal">{earlyBirdVerbatim}</p>
  </div>
</section>

<style>
  .mt-tickets {
    padding: var(--section-y) var(--gutter);
    background: var(--mt-bg);
  }
  .mt-tickets__inner {
    max-width: 54rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  /* Featured card + rows. Mobile: stacked. Desktop: featured left + rows right. */
  .mt-tickets__cols {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .mt-tickets__featured {
    width: 100%;
  }
  .mt-tickets__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  /* Sales-close tag — magenta pill (magenta-50 bg, magenta-700 text). */
  .mt-tickets__tag {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-mt-magenta-50);
    color: var(--color-mt-magenta-700);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }
  .mt-tickets__flag {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }

  .mt-tickets__cta {
    width: 100%;
    max-width: var(--measure);
  }
  .mt-tickets__caption {
    margin: 0;
    max-width: var(--measure);
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-snug);
    color: var(--mt-text-muted);
  }

  @media (min-width: 768px) {
    .mt-tickets__cols {
      flex-direction: row;
      align-items: stretch;
      gap: var(--space-7);
    }
    .mt-tickets__featured {
      flex: 0 0 20rem;
    }
    .mt-tickets__rows {
      flex: 1 1 auto;
      align-self: center;
    }
    .mt-tickets__cta {
      max-width: 24rem;
    }
  }
</style>
