---
/**
 * SponsorChip — one white chip looped over a sponsor tier. Each logo sits on
 * --mt-surface with a 1px --mt-divider keyline and uniform padding, contained to
 * a fixed height, so mismatched logos read as one set. Resolved from sponsors.ts
 * via import.meta.glob → astro:assets <Image> (intrinsic w/h auto, lazy).
 * `--primary` = the larger Polygon chip.
 *
 * Some delivered logos carry their own background (Luxe = a dark-bg tile so its
 * metallic mark stays legible, Arctic/TLB = full-bleed brand tiles, Osmans has a
 * harmless white box) — kept as delivered; the dark Luxe tile reads as its own
 * dark mini-panel.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Sponsor } from "../../data/muslimah-today/sponsors.ts";

interface Props {
  sponsor: Sponsor;
  /** Larger treatment for the primary (Polygon) chip. */
  primary?: boolean;
  /** Smaller treatment for the scrolling sponsor marquee rows. */
  compact?: boolean;
}
const { sponsor, primary = false, compact = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/muslimah-today/logos/*.{png,jpg,jpeg,svg}",
  { eager: true },
);
const img = images[`../../assets/muslimah-today/logos/${sponsor.logo}`]?.default;
---
<div class={`mt-chip ${primary ? "mt-chip--primary" : ""} ${compact ? "mt-chip--compact" : ""}`}>
  {img ? (
    <Image class="mt-chip__logo" src={img} alt={sponsor.name} loading={compact ? "eager" : "lazy"} />
  ) : (
    <span class="mt-chip__fallback">{sponsor.name}</span>
  )}
</div>

<style>
  /* Uniform card; the logo fills it (object-fit:contain) with a readable padding gap,
     so it's as large as possible without touching the edges. */
  .mt-chip {
    /* border-box is NOT inherited from a global reset on the MT page (unlike the
       bursary site's Tailwind preflight) — without it, width:100% + padding made
       every chip 26px wider than its marquee cell, overlapping the next chip. */
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5.5rem;              /* fixed → every sponsor card is identical */
    padding: 0.8rem 1.1rem;      /* the gap around the logo */
    background: var(--mt-surface);
    border: 1px solid var(--mt-divider);
    border-radius: var(--radius-md);
  }
  .mt-chip__logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;         /* fill the padded card, keep aspect ratio */
  }
  .mt-chip__fallback {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--mt-text-muted);
    text-align: center;
  }

  .mt-chip--primary {
    height: 7rem;
    padding: 1rem 1.6rem;
  }
  /* Compact — the scrolling marquee rows (smaller so more logos flow past). */
  .mt-chip--compact {
    height: 4.25rem;
    padding: 0.5rem 0.75rem;
  }

  @media (min-width: 768px) {
    .mt-chip {
      height: 6.25rem;
    }
    .mt-chip--primary {
      height: 8rem;
    }
    .mt-chip--compact {
      height: 4.75rem;
    }
  }
</style>
