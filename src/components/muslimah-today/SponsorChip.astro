---
/**
 * SponsorChip — one white chip looped over a sponsor tier (design/02 "Sponsor tier
 * row/grid"). Each logo sits on --mt-surface with a 1px --mt-divider keyline and
 * uniform padding, contained to a fixed max-height, so mismatched logos read as one
 * set. Resolved from sponsors.ts via import.meta.glob → astro:assets <Image>
 * (intrinsic w/h auto, lazy). `--primary` = the larger Polygon chip.
 *
 * Some delivered logos carry their own background (Luxe = a dark-bg tile so its
 * metallic mark stays legible, Arctic/TLB = full-bleed brand tiles, Osmans has a
 * harmless white box) — kept as processed in A1 (the dark Luxe tile reads as its own
 * dark mini-panel, sanctioned by design/02).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Sponsor } from "../../data/muslimah-today/sponsors.ts";

interface Props {
  sponsor: Sponsor;
  /** Larger treatment for the primary (Polygon) chip. */
  primary?: boolean;
}
const { sponsor, primary = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/muslimah-today/logos/*.{png,jpg,jpeg,svg}",
  { eager: true },
);
const img = images[`../../assets/muslimah-today/logos/${sponsor.logo}`]?.default;
---
<div class={`mt-chip ${primary ? "mt-chip--primary" : ""}`}>
  {img ? (
    <Image class="mt-chip__logo" src={img} alt={sponsor.name} loading="lazy" />
  ) : (
    <span class="mt-chip__fallback">{sponsor.name}</span>
  )}
</div>

<style>
  .mt-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    min-height: 4.75rem;
    background: var(--mt-surface);
    border: 1px solid var(--mt-divider);
    border-radius: var(--radius-md);
  }
  .mt-chip__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 2.75rem; /* ~48px cap (design/02) */
    object-fit: contain;
  }
  .mt-chip__fallback {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--mt-text-muted);
    text-align: center;
  }

  .mt-chip--primary {
    min-height: 6rem;
    padding: var(--space-5) var(--space-6);
  }
  .mt-chip--primary .mt-chip__logo {
    max-height: 4rem;
  }

  @media (min-width: 768px) {
    .mt-chip {
      min-height: 5.5rem;
    }
    .mt-chip__logo {
      max-height: 3.25rem; /* ~64px cap (design/02) */
    }
    .mt-chip--primary {
      min-height: 7rem;
    }
    .mt-chip--primary .mt-chip__logo {
      max-height: 5rem;
    }
  }
</style>
