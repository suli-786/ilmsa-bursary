---
/**
 * Hero — section #top (design/03 §2). Welcome + identity + the essential facts +
 * the primary action; the "arch-dawn" wow. Aims for ~one mobile viewport.
 *
 * Composition (mobile-first, centred): ILM-for-Women STACKED logo top-centre →
 * the one grand arch (--radius-arch) holding the "Daybreak" light-bloom at its crown
 * with the MT wordmark seated BELOW it on the clear off-white inner zone (never over
 * the lilac glow, per design/02) → title + tagline → facts strip (date/time · venue →
 * Maps · Tickets from R250 → #tickets) → the primary Book CTA (the one saturated
 * magenta moment, M5-disabled for now) → scroll cue.
 *
 * Copy is VERBATIM from event.ts (← 01-content.md §1). The h1 is the conference
 * identity: the MT wordmark IMAGE (alt="Muslimah Today", never live text) + the
 * title text. The arch + bloom are aria-hidden; the tagline is real text.
 *
 * Sentinel: the whole section carries [data-mt-hero-sentinel] so the Header stays
 * transparent while ANY of the hero is in view (→ solid once fully scrolled past) and
 * the sticky Book bar stays hidden over the hero (→ shows after). Robust to hero
 * height; see STATUS [WORKER-CHANGE].
 *
 * Motion "arch-dawn" (load, once): bloom + wordmark rise, then title/tagline/facts/CTA
 * stagger in (animation-delay). Every layer is .daybreak-dawn/-dawn-bloom → fully lit
 * & static under reduced-motion (global rule).
 */
import { Image } from "astro:assets";
import { event } from "../../data/muslimah-today/event.ts";
import BookButton from "./BookButton.astro";
import ilmForWomen from "../../assets/muslimah-today/logos/org-ilm-for-women-stacked.png";
import wordmark from "../../assets/muslimah-today/logos/logo-muslimah-today.png";

const tagline = event.tagline.join(" · ");
---
<section id="top" class="mt-hero" data-mt-hero-sentinel>
  <div class="mt-hero__inner">
    <Image
      class="mt-hero__org daybreak-dawn"
      src={ilmForWomen}
      alt="ILM for Women"
      widths={[220, 320, 440]}
      sizes="(min-width: 768px) 280px, 220px"
      loading="eager"
      style="animation-delay: 40ms"
    />

    <div class="mt-hero__arch">
      <div class="mt-hero__bloom daybreak-dawn-bloom" aria-hidden="true"></div>
      <div class="mt-hero__arch-content">
        <h1 class="mt-hero__identity">
          <Image
            class="mt-hero__wordmark daybreak-dawn"
            src={wordmark}
            alt="Muslimah Today"
            widths={[240, 320, 480]}
            sizes="(min-width: 768px) 320px, 240px"
            loading="eager"
            style="animation-delay: 120ms"
          />
          <span class="mt-hero__title daybreak-dawn" style="animation-delay: 200ms">{event.title}</span>
        </h1>
        <p class="mt-hero__tagline daybreak-dawn" style="animation-delay: 260ms">{tagline}</p>
      </div>
    </div>

    <div class="mt-hero__facts daybreak-dawn" style="animation-delay: 340ms">
      <p class="mt-hero__datetime">{event.dateTimeFull}</p>
      <p class="mt-hero__factlinks">
        <a class="mt-hero__link" href={event.mapsUrl} target="_blank" rel="noopener noreferrer">
          <svg class="mt-hero__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>{event.venue}</span>
          <span class="mt-hero__chev" aria-hidden="true">›</span>
        </a>
        <a class="mt-hero__link" href="#tickets">
          Tickets from {event.ticketsFrom}
          <span class="mt-hero__chev" aria-hidden="true">›</span>
        </a>
      </p>
    </div>

    <div class="mt-hero__cta daybreak-dawn" style="animation-delay: 420ms">
      <BookButton block />
    </div>
  </div>

  <div class="mt-hero__scrollcue daybreak-dawn" aria-hidden="true" style="animation-delay: 540ms">
    <span class="mt-hero__scrollcue-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </span>
  </div>
</section>

<style>
  .mt-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--space-8) + env(safe-area-inset-top)) var(--gutter) var(--space-8);
    text-align: center;
    background: var(--mt-bg);
    overflow: clip;
  }
  .mt-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    width: 100%;
    max-width: var(--container);
  }

  /* ILM for Women lockup (top-centre). */
  .mt-hero__org {
    display: block;
    width: clamp(11rem, 52vw, 14rem);
    height: auto;
  }

  /* The one grand arch — rounded-top niche holding the dawn-bloom + identity. */
  .mt-hero__arch {
    position: relative;
    width: clamp(16rem, 84vw, 26rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: clamp(2.5rem, 15vw, 4.5rem) var(--space-5) var(--space-6);
    background: var(--mt-bg);
    border: 1px solid var(--mt-border);
    border-radius: var(--radius-arch);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  /* Light-bloom at the crown; fades to clear off-white where the wordmark sits.
     A slightly denser local glow (magenta-200 ↔ lilac-200 — still palette tints, no
     new hue) so the "dawn" is actually perceptible: the shared --mt-glow's 100-level
     tints wash out to invisible at the bloom's 0.5 opacity. Positioned via inset
     (NOT transform) so the dawn-bloom keyframe's scale is free. */
  .mt-hero__bloom {
    position: absolute;
    left: -15%;
    right: -15%;
    top: -8%;
    height: 64%;
    z-index: 0;
    background: radial-gradient(68% 58% at 50% 32%,
      var(--color-mt-magenta-200) 0%,
      var(--color-mt-lilac-200) 46%,
      transparent 72%);
  }
  .mt-hero__arch-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
  }

  .mt-hero__identity {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    line-height: var(--lh-snug);
    letter-spacing: normal;
  }
  .mt-hero__wordmark {
    display: block;
    width: clamp(13rem, 58vw, 17rem);
    height: auto;
  }
  /* Title — the conference identity line; Source Sans tracked caps (wordmark echo). */
  .mt-hero__title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--mt-heading);
    max-width: 16ch;
  }
  /* Tagline — Caslon Text italic (the italic companion), magenta-600. Real text. */
  .mt-hero__tagline {
    margin: 0;
    font-family: var(--font-serif-text);
    font-style: italic;
    font-size: var(--text-md);
    line-height: var(--lh-snug);
    color: var(--mt-accent);
  }

  /* Facts strip — date/time (ink) + venue → Maps + Tickets → #tickets. */
  .mt-hero__facts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .mt-hero__datetime {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--mt-text);
  }
  .mt-hero__factlinks {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .mt-hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--mt-link);
    text-decoration: none;
  }
  .mt-hero__link:hover,
  .mt-hero__link:focus-visible {
    color: var(--mt-link-hover);
  }
  .mt-hero__link:hover span:not(.mt-hero__chev),
  .mt-hero__link:focus-visible span:not(.mt-hero__chev) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mt-hero__pin {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .mt-hero__chev {
    font-weight: 400;
    line-height: 1;
  }

  /* Primary CTA — full-width on mobile, comfortable inline width on desktop. */
  .mt-hero__cta {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* Scroll cue — pinned bottom-centre (left/right + margin so the dawn translateY
     and the bounce don't fight a translateX). */
  .mt-hero__scrollcue {
    position: absolute;
    bottom: var(--space-5);
    left: 0;
    right: 0;
    margin-inline: auto;
    width: fit-content;
    color: var(--mt-accent);
  }
  .mt-hero__scrollcue-icon {
    display: block;
    animation: mt-hero-bob 1.8s var(--ease-standard) infinite;
  }
  .mt-hero__scrollcue svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  @keyframes mt-hero-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* Desktop — arch scales up; facts strip becomes one inline row; CTA inline-width. */
  @media (min-width: 768px) {
    .mt-hero__inner {
      gap: var(--space-6);
    }
    .mt-hero__facts {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: var(--space-5);
      row-gap: var(--space-2);
    }
    .mt-hero__factlinks {
      flex-direction: row;
      column-gap: var(--space-5);
    }
    .mt-hero__cta {
      max-width: 22rem;
    }
  }
</style>
