---
/**
 * TicketTier — one component looped over ticketTiers[] (design/03 §7, design/02
 * "Ticket tier card"). `variant` selects the frame: "featured" = the magenta
 * early-bird card (R250 the single biggest glance target) · "row" = an off-white
 * list row (label · dotted leader · right-aligned number/action · fine-print
 * sub-line). The structural guarantee of equal sizing/alignment across tiers.
 *
 * Links: the row WhatsApp (pensioner/student) is live now (a phone link, not
 * M5-gated). The sponsored "apply" → MTSP2026 is M5-gated: while
 * event.links.sponsored.live is false it renders DISABLED ("opens soon"), the URL
 * already wired so B6 just flips the flag. Numbers right-aligned & mutually aligned.
 */
import type { TicketTier } from "../../data/muslimah-today/ticket-tiers.ts";
import { event } from "../../data/muslimah-today/event.ts";
import { withBase } from "../../utils/paths.ts";

interface Props {
  tier: TicketTier;
}
const { tier } = Astro.props;

const sponsored = event.links.sponsored;
const whatsapp = event.links.whatsappBooking;
---
{tier.variant === "featured" ? (
  <div class="mt-tcard">
    <div class="mt-tcard__bloom daybreak-bloom" aria-hidden="true"></div>
    <div class="mt-tcard__body">
      <p class="mt-tcard__label">{tier.label}</p>
      <p class="mt-tcard__price">{tier.price}</p>
      <p class="mt-tcard__when">{tier.priceNote}</p>
      {tier.secondary && <p class="mt-tcard__then">{tier.secondary}</p>}
      {tier.inclusions && (
        <ul class="mt-tcard__incl">
          {tier.inclusions.map((inc) => (
            <li class="mt-tcard__incl-item">
              <svg class="mt-tcard__check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 10.5 8 14.5 16 5.5" />
              </svg>
              <span>{inc}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
) : (
  <li class="mt-trow">
    <div class="mt-trow__main">
      <span class="mt-trow__label">{tier.label}</span>
      <span class="mt-trow__leader" aria-hidden="true"></span>
      {tier.price ? (
        <span class="mt-trow__price">{tier.price}</span>
      ) : tier.action?.kind === "apply" ? (
        sponsored.live ? (
          <a class="mt-trow__action" href={withBase(sponsored.url)} target="_blank" rel="noopener noreferrer">
            {tier.action.label}<span class="mt-trow__chev" aria-hidden="true">›</span>
          </a>
        ) : (
          <span class="mt-trow__action mt-trow__action--off" aria-disabled="true">{tier.action.label}</span>
        )
      ) : null}
    </div>
    {(tier.action?.kind === "whatsapp" || (tier.action?.kind === "apply" && !sponsored.live) || tier.note) && (
      <p class="mt-trow__sub">
        {tier.action?.kind === "whatsapp" && (
          <a class="mt-trow__wa" href={whatsapp.url} target="_blank" rel="noopener noreferrer">
            {tier.action.label}<span class="mt-trow__chev" aria-hidden="true">›</span>
          </a>
        )}
        {tier.action?.kind === "apply" && !sponsored.live && (
          <span class="mt-trow__soon">opens soon</span>
        )}
        {tier.note && <span class="mt-trow__note">{tier.note}</span>}
      </p>
    )}
  </li>
)}

<style>
  /* ── Featured early-bird card — the one magenta glance target ────────────── */
  .mt-tcard {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--mt-feature);
    color: var(--mt-on-feature);
    box-shadow: var(--shadow-lg);
    padding: var(--space-7) var(--space-6);
    height: 100%;
  }
  .mt-tcard__bloom {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .mt-tcard__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }
  .mt-tcard__label {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
    color: var(--mt-on-feature);
  }
  /* R250 — Caslon Display, the single biggest number on the page. */
  .mt-tcard__price {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--mt-on-feature);
  }
  .mt-tcard__when {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--mt-on-feature);
  }
  .mt-tcard__then {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--mt-on-feature);
    opacity: 0.85;
  }
  .mt-tcard__incl {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .mt-tcard__incl-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--mt-on-feature);
  }
  .mt-tcard__check {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ── List rows — ultra-clear: label · dotted leader · right number/action ─── */
  .mt-trow {
    list-style: none;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--mt-divider);
  }
  .mt-trow:first-child {
    border-top: 0;
  }
  .mt-trow__main {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .mt-trow__label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--mt-text);
  }
  .mt-trow__leader {
    flex: 1 1 auto;
    align-self: flex-end;
    margin-bottom: 0.35em;
    min-width: var(--space-5);
    border-bottom: 2px dotted var(--mt-divider);
  }
  .mt-trow__price {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--mt-heading);
    white-space: nowrap;
  }
  .mt-trow__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    padding-inline: var(--space-1);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--mt-link);
    text-decoration: none;
    white-space: nowrap;
  }
  .mt-trow__action:hover,
  .mt-trow__action:focus-visible {
    color: var(--mt-link-hover);
  }
  /* Sponsored apply — M5 disabled (MTSP2026 not live). */
  .mt-trow__action--off {
    color: var(--mt-text-muted);
    cursor: not-allowed;
  }
  .mt-trow__chev {
    font-weight: 400;
  }
  .mt-trow__sub {
    margin: var(--space-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }
  .mt-trow__wa {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--mt-link);
    text-decoration: none;
  }
  .mt-trow__wa:hover,
  .mt-trow__wa:focus-visible {
    color: var(--mt-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mt-trow__soon {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    color: var(--mt-text-muted);
  }
  .mt-trow__note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--lh-snug);
    color: var(--mt-text-muted);
  }
</style>
