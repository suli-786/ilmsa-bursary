---
/**
 * BaseLayout — minimal, MT-specific page shell (own <head>, title, meta).
 * Imports ONLY the Muslimah Today stylesheet — never the bursary global styles
 * or any bursary component. Lives under src/components/muslimah-today/ (scope fence;
 * src/layouts/ is out of scope), used as the page layout via <slot/>.
 */
import "../../styles/muslimah-today.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muslimah Today 2026 — 13th Annual Women's Conference",
  description = "Muslimah Today: Sisterhood · Inspiration · Spiritual Upliftment. Saturday, 29th August 2026, NMJ Islamic Centre, Durban. Hosted by ILM for Women, a division of ILM-SA.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fefdfe" />
    <title>{title}</title>
    {/* Arm the "Daybreak" pre-reveal state before paint (no FOUC); without JS the
        page stays fully visible. Runs synchronously in <head>, so is:inline. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Reveal fallback for browsers without CSS scroll-driven animations: toggle
  // `.is-inview` on Daybreak elements ~15% into view. Modern browsers use the pure-CSS
  // `animation-timeline: view()` path and skip this. No-op under reduced-motion (the
  // CSS already pins those elements to their final state).
  const supportsScrollDriven =
    typeof CSS !== "undefined" && CSS.supports("animation-timeline", "view()");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!supportsScrollDriven && !reduced && "IntersectionObserver" in window) {
    const els = document.querySelectorAll(
      ".daybreak-reveal, .daybreak-settle, .daybreak-rule, .daybreak-bloom",
    );
    if (els.length) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-inview");
              obs.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      els.forEach((el) => io.observe(el));
    }
  }
</script>
