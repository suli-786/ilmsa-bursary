---
/**
 * About — section #about (design/03 §3). Orient a newcomer + establish credibility;
 * warm, dignified, short. Eyebrow + Caslon headline → the verbatim About paragraph
 * (from about.ts ← 01-content.md §3) opening with a SR-safe Caslon-italic drop-cap →
 * one warm full-colour past-event companion photo.
 *
 * Drop-cap is a CSS `::first-letter` pseudo-element on the real paragraph, so screen
 * readers read the word "Muslimah" intact (no decorative duplicate). Body measure is
 * capped at --measure (≤64ch). Desktop = 2-col (text left ≤64ch · photo right).
 */
import { about } from "../../data/muslimah-today/about.ts";
import SectionHeader from "./SectionHeader.astro";
import { Image } from "astro:assets";
import aboutPhoto from "../../assets/muslimah-today/past-events/gallery-embrace.jpg";
---
<section id="about" class="mt-about" aria-labelledby="mt-about-title">
  <div class="mt-about__inner">
    <div class="mt-about__text">
      <SectionHeader eyebrow={about.eyebrow} heading={about.heading} headingId="mt-about-title" />
      <p class="mt-about__body daybreak-reveal">{about.body}</p>
    </div>
    <figure class="mt-about__media daybreak-reveal">
      <Image
        class="mt-about__photo"
        src={aboutPhoto}
        alt="Two attendees embracing at a past Muslimah Today conference"
        widths={[480, 768, 960]}
        sizes="(min-width: 768px) 38vw, 90vw"
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .mt-about {
    padding: var(--section-y) var(--gutter);
    background: var(--mt-bg);
  }
  .mt-about__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .mt-about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .mt-about__body {
    margin: 0;
    max-width: var(--measure);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--mt-text);
  }
  /* Drop-cap — Caslon Text italic on the REAL first letter (SR-safe). magenta-400
     (not the system's softer magenta-300) so the enlarged letter clears the
     large-text AA 3:1 floor on off-white; see STATUS [WORKER-CHANGE]. */
  .mt-about__body::first-letter {
    font-family: var(--font-serif-text);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: 0.78;
    color: var(--color-mt-magenta-400);
    float: left;
    margin-right: var(--space-3);
    margin-top: 0.08em;
  }
  .mt-about__media {
    margin: 0;
  }
  .mt-about__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--mt-border);
  }

  /* Desktop — text left (≤64ch) + photo right. */
  @media (min-width: 768px) {
    .mt-about__inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
    }
    .mt-about__text {
      flex: 1 1 0;
    }
    .mt-about__media {
      flex: 0 0 38%;
      align-self: stretch;
      display: flex;
    }
    .mt-about__photo {
      object-fit: cover;
      height: 100%;
    }
  }
</style>
