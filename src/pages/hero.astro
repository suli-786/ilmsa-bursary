  <script is:inline>
    document.documentElement.classList.add('js');
    // Edition count-up: 1 → 13 once on load. The ordinal ("th") is hidden during
    // the count (so it never reads "2th, 3th…") and fades in only when it settles.
    (function () {
      var el = document.getElementById('count');
      if (!el) return;
      var ord = document.querySelector('.bignum .ord');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { el.textContent = '13'; if (ord) ord.style.opacity = '1'; return; }
      if (ord) ord.style.opacity = '0';
      var target = 13, dur = 1150, start = null;
      function ease(t) { return 1 - Math.pow(1 - t, 3); }
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        el.textContent = String(Math.max(1, Math.round(ease(p) * target)));
        if (p < 1) { requestAnimationFrame(step); }
        else { el.textContent = '13'; if (ord) ord.style.opacity = '1'; }
      }
      setTimeout(function () { requestAnimationFrame(step); }, 360);
    })();

    // Generic count-up for [data-count-to] (e.g. the R250 price on reveal).
    function countUp(el) {
      if (el.dataset.counted) return;
      el.dataset.counted = '1';
      var target = parseInt(el.getAttribute('data-count-to'), 10) || 0;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = String(target); return;
      }
      var dur = 1100, start = null;
      function ease(t) { return 1 - Math.pow(1 - t, 3); }
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        el.textContent = String(Math.round(ease(p) * target));
        if (p < 1) requestAnimationFrame(step); else el.textContent = String(target);
      }
      requestAnimationFrame(step);
    }

    // Early-bird countdown — live days-left, with graceful states past the deadline.
    (function () {
      var el = document.querySelector('.tk-countdown');
      if (!el) return;
      var txt = el.querySelector('.tk-cd-text');
      var deadline = new Date(el.getAttribute('data-deadline'));
      if (isNaN(deadline)) return;
      var ms = deadline - new Date();
      var days = Math.ceil(ms / 86400000);
      if (days > 1) {
        txt.innerHTML = '<b>' + days + '</b>&nbsp;days left at the early-bird rate';
      } else if (days === 1) {
        txt.innerHTML = '<b>1</b>&nbsp;day left at the early-bird rate';
      } else if (days === 0) {
        txt.textContent = 'Last day for the early-bird rate';
      } else {
        var w = el.closest('.tk-cd-wrap');
        if (w) w.style.display = 'none';
      }
    })();

    // Scroll reveal (.reveal / .reveal-head / .pe-item) + count-ups. Position-based
    // (checked on scroll via rAF) so a fast fling can never leave a block hidden.
    (function () {
      var els = [].slice.call(document.querySelectorAll('.reveal, .reveal-head, .pe-item'));
      function activate(t) {
        t.classList.add('in');
        if (t.querySelectorAll) t.querySelectorAll('[data-count-to]').forEach(countUp);
        if (t.hasAttribute && t.hasAttribute('data-count-to')) countUp(t);
      }
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(activate); return;
      }
      var pending = els.slice(), ticking = false;
      function check() {
        var vh = window.innerHeight || document.documentElement.clientHeight;
        pending = pending.filter(function (el) {
          if (el.getBoundingClientRect().top < vh * 0.9) { activate(el); return false; }
          return true;
        });
        if (!pending.length) {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; check(); });
      }
      check();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    })();

    // Lightbox for the past-event gallery (progressive: links open the image if JS is off).
    (function () {
      var box = document.querySelector('.lightbox');
      var links = [].slice.call(document.querySelectorAll('.pe-open'));
      if (!box || !links.length) return;
      var imgEl = box.querySelector('.lightbox-img');
      var capEl = box.querySelector('.lightbox-cap');
      var idx = 0, lastFocus = null;
      function render(i) {
        idx = (i + links.length) % links.length;
        var a = links[idx], im = a.querySelector('img');
        imgEl.setAttribute('src', a.getAttribute('href'));
        imgEl.setAttribute('alt', im ? im.getAttribute('alt') : '');
        capEl.textContent = im ? im.getAttribute('alt') : '';
      }
      function open(i, trigger) {
        lastFocus = trigger || document.activeElement;
        render(i);
        box.classList.add('open');
        box.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        box.querySelector('.lightbox-close').focus();
      }
      function close() {
        box.classList.remove('open');
        box.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      links.forEach(function (a, i) {
        a.addEventListener('click', function (e) { e.preventDefault(); open(i, a); });
      });
      box.querySelector('.lightbox-close').addEventListener('click', close);
      box.querySelector('.lightbox-prev').addEventListener('click', function () { render(idx - 1); });
      box.querySelector('.lightbox-next').addEventListener('click', function () { render(idx + 1); });
      box.addEventListener('click', function (e) { if (e.target === box) close(); });
      document.addEventListener('keydown', function (e) {
        if (!box.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') render(idx - 1);
        else if (e.key === 'ArrowRight') render(idx + 1);
        else if (e.key === 'Tab') {
          var f = box.querySelectorAll('button'), first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
    })();
  </script>

  <script>
    // About — pinned scrollytelling. GSAP ScrollTrigger scrubs a cross-fade while the
    // stage is held by position:sticky. Base CSS keeps the 4 layers stacked + readable;
    // this only adds `.ab-anim` when motion is allowed, so no-JS / reduced-motion users
    // get the plain stacked version.
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const about = document.querySelector(".about");
    if (about) {
      const track = about.querySelector(".ab-track");
      const rail = about.querySelector(".ab-rail");
      const layers = gsap.utils.toArray<HTMLElement>(".about .ab-layer");
      const inners = layers.map((l) => l.querySelector(".ab-layer-in") as HTMLElement);
      ScrollTrigger.config({ ignoreMobileResize: true });

      // Pinned cross-fade on all sizes (mobile layers are compacted in CSS so each
      // fits one screen); only reduced-motion / no-JS falls back to the stacked mode.
      const mm = gsap.matchMedia();
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        about.classList.add("ab-anim");
        gsap.set(layers, { opacity: 0 });
        gsap.set(inners, { y: 42 });
        gsap.set(layers[0], { opacity: 1 });
        gsap.set(inners[0], { y: 0 });

        const tl = gsap.timeline({
          defaults: { ease: "power1.inOut" },
          scrollTrigger: { trigger: track, start: "top top", end: "bottom bottom", scrub: 0.6 },
        });
        tl.to({}, { duration: 0.6 }); // hold on the opening layer before the first cross-fade
        for (let i = 1; i < layers.length; i++) {
          tl.to(layers[i - 1], { opacity: 0, duration: 1 })
            .to(inners[i - 1], { y: -42, duration: 1 }, "<")
            .to(layers[i], { opacity: 1, duration: 1 }, "<")
            .to(inners[i], { y: 0, duration: 1 }, "<")
            .to({}, { duration: 0.5 }); // hold on each layer before the next
        }
        tl.to({}, { duration: 0.6 }); // hold on the past-speakers layer
        tl.to(rail, { xPercent: -100, duration: 1.6, ease: "none" }); // pan LEFT → Testimonials
        tl.to({}, { duration: 0.6 }); // settle on Testimonials

        ScrollTrigger.refresh();
        return () => {
          about.classList.remove("ab-anim");
          gsap.set([...layers, ...inners, rail], { clearProps: "all" });
        };
      });

      window.addEventListener("load", () => ScrollTrigger.refresh());
    }
  </script>
</body>
</html>
