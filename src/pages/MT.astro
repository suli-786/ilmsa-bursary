---
/**
 * Muslimah Today 2026 — route /MT (D23).
 * Self-contained MT page: uses the namespaced BaseLayout + the dedicated
 * muslimah-today.css design system. Never pulls in the bursary global styles or
 * any bursary component. Book CTA target → www.ilmsa.co.za/MT2026 (Quicket, M5-gated).
 *
 * Build state (S2/B1c): scaffold + global shell wired (skip link · Header · sticky
 * Book bar). The sections (Hero → About → Speakers → Testimonials → Past-events →
 * Tickets → Footer) land in S3–S4 inside <main>, each rendered from
 * src/data/muslimah-today/*.
 */
import BaseLayout from "../components/muslimah-today/BaseLayout.astro";
import Header from "../components/muslimah-today/Header.astro";
import BookBar from "../components/muslimah-today/BookBar.astro";
import Hero from "../components/muslimah-today/Hero.astro";
import About from "../components/muslimah-today/About.astro";
import Speakers from "../components/muslimah-today/Speakers.astro";
import Testimonials from "../components/muslimah-today/Testimonials.astro";
import PastEvents from "../components/muslimah-today/PastEvents.astro";
import Tickets from "../components/muslimah-today/Tickets.astro";
import Footer from "../components/muslimah-today/Footer.astro";
---
<BaseLayout>
  <a class="mt-skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Speakers />
    <Testimonials />
    <PastEvents />
    <Tickets />
  </main>
  <Footer />
  <BookBar />
</BaseLayout>

<style>
  /* Skip link — first focusable element; visually hidden until focused (design/03 §1). */
  .mt-skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: var(--z-modal);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--mt-feature);
    color: var(--mt-on-feature);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transform: translateY(calc(-100% - var(--space-6)));
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .mt-skip-link:focus {
    transform: translateY(0);
  }
  /* main receives focus from the skip link without showing a focus outline on click. */
  #main:focus {
    outline: none;
  }
</style>
